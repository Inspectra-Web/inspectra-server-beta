# INSPECTRA API - environment template
# Copy to .env and fill in. Keep the two files in sync.
# Every key below is read through src/config/env.config.ts.

# --- Required ---------------------------------------------------------------
# The server reads all of these. A missing one fails at the point of use, not
# at startup, so fill them all in before running.

NODE_ENV=development
PORT=5000

# Origin allowed by CORS, and the base for the links in verification and
# password reset emails. Must match the Vite dev server.
CLIENT_URL=http://localhost:5173

# MongoDB connection string (local service or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/inspectra

# Auth. Generate the secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_EXPIRES_IN is the token lifetime; JWT_COOKIE_EXPIRES_DAYS is the cookie's.
# Keep the two in step or a live cookie can outlast its token.
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_DAYS=7

# Email delivery (Resend). Registration and password reset both send mail, so
# without these the auth flows fail. RESEND_EMAIL is the From address and must
# sit on a domain verified in your Resend dashboard.
RESEND_API_KEY=
RESEND_EMAIL=no-reply@example.com

# Media uploads (Cloudinary). Read by src/config/cloudinary.config.ts, which the
# avatar upload uses. Find all three on your Cloudinary dashboard. Uploads are
# resized to 512x512 JPEG and stored under the inspectra/avatars folder.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# First admin account. Admins are seeded, never self-registered, so these are
# how the first one comes into existence. Read only by src/scripts/admin.script.ts
# via `npm run seed:admin`, which is idempotent: run it again to reset the
# password or to promote an existing account. The seeded admin signs in at
# /admin/login, not the public /login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULLNAME=

# --- Declared but not read yet ----------------------------------------------
# Present in src/config/env.config.ts, but no code reads them today. Leave them
# blank until the feature that needs them ships.

# Resend inbound/webhook signature verification
RESEND_WEBHOOK_SECRET=
