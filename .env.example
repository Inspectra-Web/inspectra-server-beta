# INSPECTRA API - environment template
# Copy to .env and fill in. Keep the two files in sync.

NODE_ENV=development
PORT=5000

# Origin allowed by CORS. Must match the Vite dev server.
CLIENT_URL=http://localhost:5173

# MongoDB connection string (local service or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/inspectra

# Auth (Phase 5). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_DAYS=7

# --- Phase 7+ integrations -------------------------------------------------
# Optional today. Move the key into REQUIRED in src/config/env.ts once the
# code that needs it actually ships.

# Email (Resend)
RESEND_API_KEY=
RESEND_EMAIL=
RESEND_WEBHOOK_SECRET=

# Media (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
